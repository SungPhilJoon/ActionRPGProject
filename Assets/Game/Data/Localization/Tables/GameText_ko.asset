    m_Localized: "V \uBE14\uB7EC\uB4DC \uD68D\uB4DD\n<size=26>\uBBF8\uB178\uD0C0\uC6B0\uB85C\uC2A4
      \uAD70\uC8FC\uAC00 \uC4F0\uB7EC\uC84C\uC2B5\uB2C8\uB2E4. \uB370\uBAA8 \uD074\uB9AC\uC5B4
      - \uD50C\uB808\uC774\uD574 \uC8FC\uC154\uC11C \uAC10\uC0AC\uD569\uB2C8\uB2E4!</size>"
    m_Metadata:
      m_Items: []
  - m_Id: 56
    m_Localized: "\uBCF4\uC0C1:"
    m_Metadata:
      m_Items: []
  - m_Id: 57
    m_Localized: "\uD29C\uD1A0\uB9AC\uC5BC"
    m_Metadata:
      m_Items: []
  - m_Id: 58
    m_Localized: "\uC0AC\uB0E5"
    m_Metadata:
      m_Items: []
  - m_Id: 59
    m_Localized: "V \uBE14\uB7EC\uB4DC"
    m_Metadata:
      m_Items: []
  - m_Id: 7001
    m_Localized: "\uAC01\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 7101
    m_Localized: "\uAE34 \uC7A0\uC5D0\uC11C \uAE68\uC5B4\uB0AC\uC2B5\uB2C8\uB2E4.
      WASD \uB85C \uAC78\uC73C\uBA70 \uBAB8\uC744 \uD480\uC5B4 \uBCF4\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7002
    m_Localized: "\uAC15\uCCA0\uC758 \uB9DB"
    m_Metadata:
      m_Items: []
  - m_Id: 7102
    m_Localized: "\uB9C8\uC6B0\uC2A4 \uC67C\uCABD \uBC84\uD2BC\uC73C\uB85C \uBB34\uAE30\uB97C
      \uD718\uB450\uB974\uC138\uC694. \uBC15\uC790\uC5D0 \uB9DE\uCDB0 \uB204\uB974\uBA74
      \uCF64\uBCF4\uAC00 \uC774\uC5B4\uC9D1\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7003
    m_Localized: "\uBB34\uAE30 \uAE30\uC220"
    m_Metadata:
      m_Items: []
  - m_Id: 7103
    m_Localized: "\uBB34\uAE30 \uC2A4\uD0AC\uC744 \uC4F0\uC138\uC694. Q \uC640 E
      \uB294 \uB4E4\uACE0 \uC788\uB294 \uBB34\uAE30\uC5D0 \uB530\uB77C \uBC14\uB01D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7004
    m_Localized: "\uD53C\uC758 \uC7A5\uB9C9"
    m_Metadata:
      m_Items: []
  - m_Id: 7104
    m_Localized: "\uD53C\uC758 \uC7A5\uB9C9\uC73C\uB85C \uB3CC\uC9C4\uD558\uC138\uC694.
      \uB3CC\uC9C4\uD558\uB294 \uB3D9\uC548 \uACF5\uACA9\uC774 \uBAB8\uC744 \uD1B5\uACFC\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7005
    m_Localized: "\uD53C\uC758 \uB9C8\uBC95"
    m_Metadata:
      m_Items: []
  - m_Id: 7105
    m_Localized: "\uD63C\uB3C8\uC758 \uC5F0\uBC1C\uC744 \uC2DC\uC804\uD558\uC138\uC694.
      \uC810\uD654\uB41C \uC801\uC744 \uB2E4\uC2DC \uB9DE\uD788\uBA74 \uD3ED\uBC1C\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7006
    m_Localized: "\uC0C1\uC778"
    m_Metadata:
      m_Items: []
  - m_Id: 7106
    m_Localized: "\uC57C\uC601\uC9C0 \uC606 \uB5A0\uB3CC\uC774 \uC0C1\uC778\uACFC
      \uB300\uD654\uD558\uACE0 (\uB610\uB294 P) \uC544\uBB34 \uBB3C\uAC74\uC774\uB098
      \uBC1B\uC73C\uC138\uC694. \uBAA8\uB450 \uBB34\uB8CC\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7007
    m_Localized: "\uCC44\uC9D1\uAC00"
    m_Metadata:
      m_Items: []
  - m_Id: 7107
    m_Localized: "\uBB34\uAE30\uB85C \uB098\uBB34, \uBC14\uC704, \uB364\uBD88\uC744
      \uCCD0\uC11C \uC790\uC6D0 10\uAC1C\uB97C \uBAA8\uC73C\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7008
    m_Localized: "\uC190\uC7AC\uC8FC"
    m_Metadata:
      m_Items: []
  - m_Id: 7108
    m_Localized: "\uC81C\uC791 \uBA54\uB274\uB97C \uC5F4\uACE0 \uC544\uBB34\uAC70\uB098
      \uB9CC\uB4DC\uC138\uC694. \uCC9C \uBC29\uC5B4\uAD6C\uB294 \uC2DD\uBB3C \uC12C\uC720\uB9CC
      \uC788\uC73C\uBA74 \uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7009
    m_Localized: "\uBC24\uC744 \uC704\uD55C \uCC28\uB9BC"
    m_Metadata:
      m_Items: []
  - m_Id: 7109
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC\uB97C \uC5F4\uACE0 \uD749\uAC11 (\uCC9C
      \uB85C\uBE0C \uB610\uB294 \uAC15\uD654 \uD749\uAC11)\uC744 \uC7A5\uCC29\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7010
    m_Localized: "\uB098\uB9CC\uC758 \uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 7110
    m_Localized: "\uAC74\uCD95 \uBA54\uB274\uB97C \uC5F4\uACE0 \uC131 \uC2EC\uC7A5\uC744
      \uC124\uCE58\uD558\uC138\uC694 (\uBAA9\uC7AC 20, \uB3CC 20)."
    m_Metadata:
      m_Items: []
  - m_Id: 7011
    m_Localized: "\uC548\uC2DD\uCC98"
    m_Metadata:
      m_Items: []
  - m_Id: 7111
    m_Localized: "\uC131 \uC2EC\uC7A5 \uADFC\uCC98\uC5D0 \uAD00\uC744 \uC9C0\uC73C\uC138\uC694.
      \uC8FD\uC73C\uBA74 \uADF8\uACF3\uC5D0\uC11C \uB418\uC0B4\uC544\uB0A9\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7012
    m_Localized: "\uCCAB \uC0AC\uB0E5"
    m_Metadata:
      m_Items: []
  - m_Id: 7112
    m_Localized: "\uC57C\uC601\uC9C0 \uBC14\uB85C \uBD81\uCABD\uC5D0 \uBA54\uB450\uC0AC
      \uD30C\uC218\uAFBC\uC774 \uC228\uC5B4 \uC788\uC2B5\uB2C8\uB2E4. 3\uB9C8\uB9AC\uB97C
      \uCC98\uCE58\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7013
    m_Localized: "\uCCAB \uD761\uD608"
    m_Metadata:
      m_Items: []
  - m_Id: 7113
    m_Localized: "\uC801\uC758 \uCCB4\uB825\uC744 25% \uC544\uB798\uB85C \uB0AE\uCD98
      \uB4A4 \uD53C\uB97C \uB9C8\uC2DC\uC138\uC694. \uD53C\uB294 \uC624\uB798\uAC00\uB294
      \uBC84\uD504\uB97C \uC90D\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7014
    m_Localized: "\uBC40 \uC0AC\uB0E5"
    m_Metadata:
      m_Items: []
  - m_Id: 7114
    m_Localized: "\uD3D0\uD5C8 \uB9C8\uC744\uACFC \uBC40 \uB2AA\uC758 \uCF54\uBE0C\uB77C\uB294
      \uBA40\uB9AC\uC11C \uACF5\uACA9\uD569\uB2C8\uB2E4. 3\uB9C8\uB9AC\uB97C \uCC98\uCE58\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7015
    m_Localized: "\uAD6C\uB9AC \uC2DC\uB300"
    m_Metadata:
      m_Items: []
  - m_Id: 7115
    m_Localized: "\uB354 \uAC15\uD55C \uC801\uC774 \uAE30\uB2E4\uB9BD\uB2C8\uB2E4.
      \uC791\uC5C5\uB300\uC5D0\uC11C \uAD6C\uB9AC \uC7A5\uBE44\uB97C \uB9CC\uB4E4\uACE0
      (\uC0C1\uC778\uC5D0\uAC8C \uBC1B\uC544\uB3C4 \uB429\uB2C8\uB2E4) \uAE30\uC5B4
      \uB808\uBCA8 16\uC744 \uB2EC\uC131\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7016
    m_Localized: "\uD2B8\uB864 \uB2A5\uC120"
    m_Metadata:
      m_Items: []
  - m_Id: 7116
    m_Localized: "\uB3D9\uAD74 \uD2B8\uB864\uC740 \uBD81\uCABD \uBA40\uB9AC \uD2B8\uB864
      \uB2A5\uC120\uC744 \uB5A0\uB3D5\uB2C8\uB2E4. \uB3CC\uC9C4\uC5D0 \uC8FC\uC758\uD558\uC138\uC694.
      3\uB9C8\uB9AC\uB97C \uCC98\uCE58\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7017
    m_Localized: "V \uBE14\uB7EC\uB4DC: \uBBF8\uB178\uD0C0\uC6B0\uB85C\uC2A4 \uAD70\uC8FC"
    m_Metadata:
      m_Items: []
  - m_Id: 7117
    m_Localized: "\uBBF8\uB178\uD0C0\uC6B0\uB85C\uC2A4 \uAD70\uC8FC\uAC00 \uBD81\uB3D9\uCABD
      \uD22C\uAE30\uC7A5\uC744 \uC9C0\uBC30\uD569\uB2C8\uB2E4. \uC4F0\uB7EC\uB728\uB9AC\uACE0
      \uD53C\uB97C \uB9C8\uC154 V \uBE14\uB7EC\uB4DC\uB97C \uCC28\uC9C0\uD558\uC138\uC694."
    m_Metadata:
      m_Items: []
